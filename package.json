    "conformance",
    "indexeddb",
    "local-first",
    "pwa",
    "sqlite",
    "state-machine",
    "sync"
  ],
  "homepage": "https://github.com/jorgeavaldez/slopkit#readme",
  "license": "MIT",
  "author": "Jorge Valdez",
  "repository": {
